rules_version = '2';

// Storage holds only user-chosen avatars and stream thumbnails.
// Everything else (keys, chat, media) never touches Storage.
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 512 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)')
        && fileName.matches('[A-Za-z0-9_-]{1,40}\\.(png|jpg|jpeg|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /thumbnails/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
