{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": false,
        ".validate": "newData.hasChildren(['displayName','avatarId','createdAt','updatedAt'])"
      }
    },

    "userKeys": {
      "$uid": {
        ".read": "auth != null",
        ".write": false
      }
    },

    "streams": {
      ".read": "auth != null",
      ".indexOn": ["createdAt", "ownerUid", "state"],
      "$streamId": {
        ".write": false,
        "viewers": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        }
      }
    },

    "voiceRooms": {
      ".read": "auth != null",
      ".indexOn": ["createdAt", "ownerUid", "state"],
      "$roomId": { ".write": false }
    },

    "mcSessions": {
      ".read": false,
      ".indexOn": ["createdAt", "hostUid", "state"],
      "$sessionId": {
        ".write": false,
        ".read": "auth != null && root.child('roomMembers').child($sessionId).child(auth.uid).exists()",
        "joinCodeHash": { ".read": false },
        "joinCodeSalt": { ".read": false }
      }
    },

    "rooms": {
      "$roomId": {
        ".read": "auth != null && root.child('roomMembers').child($roomId).child(auth.uid).exists()",
        ".write": false
      }
    },

    "roomMembers": {
      "$roomId": {
        ".read": "auth != null && data.child(auth.uid).exists()",
        ".write": false,
        "$uid": {
          "presence": {
            ".write": "auth != null && auth.uid === $uid && data.parent().exists()",
            ".validate": "newData.hasChildren(['state','at']) && newData.child('state').isString() && newData.child('state').val().length <= 16 && newData.child('at').isNumber()"
          }
        }
      }
    },

    "roomKeys": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },

    "roomBans": {
      "$roomId": { ".read": false, ".write": false }
    },

    "chat": {
      "$roomId": {
        ".read": "auth != null && root.child('roomMembers').child($roomId).child(auth.uid).exists()",
        ".indexOn": ["ts"],
        "$messageId": {
          ".write": "auth != null && !data.exists() && root.child('roomMembers').child($roomId).child(auth.uid).exists() && !root.child('roomBans').child($roomId).child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['senderUid','ciphertext','nonce','keyId','ts']) && newData.children().length === 5",
          "senderUid": { ".validate": "newData.val() === auth.uid" },
          "ciphertext": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8192 && newData.val().matches(/^[A-Za-z0-9+/]+={0,2}$/)" },
          "nonce": { ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64 && newData.val().matches(/^[A-Za-z0-9+/]+={0,2}$/)" },
          "keyId": { ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)" },
          "ts": { ".validate": "newData.val() === now" }
        }
      }
    },

    "reports": {
      "$reportId": {
        ".read": false,
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['reporterUid','targetUid','reason','ts']) && newData.children().length === 4",
        "reporterUid": { ".validate": "newData.val() === auth.uid" },
        "targetUid": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "reason": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "ts": { ".validate": "newData.val() === now" }
      }
    }
  }
}
